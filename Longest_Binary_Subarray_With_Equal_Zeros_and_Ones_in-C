
#include <stdio.h>

int main() {
    int n;
    printf("Enter Size of Array: ");
    scanf("%d", &n);

    if(n < 1 || n > 50) {
        printf("Invalid Array Size!");
        return 0;
    }

    int num[50];

    printf("Enter Binary Array (0 and 1): ");
    for(int i = 0; i < n; i++) {
        scanf("%d", &num[i]);

        if(num[i] != 0 && num[i] != 1) {
            printf("Invalid Input! Only 0 and 1 allowed.");
            return 0;
        }
    }

    int maxLength = 0;

    for(int i = 0; i < n; i++) {
        int zeros = 0;
        int ones = 0;

        for(int j = i; j < n; j++) {

            if(num[j] == 0) {
                zeros++;
            } else {
                ones++;
            }

            if(zeros == ones) {
                int length = j - i + 1;

                if(length > maxLength) {
                    maxLength = length;
                }
            }
        }
    }

    printf("Longest Subarray Length: %d", maxLength);

    return 0;
}
