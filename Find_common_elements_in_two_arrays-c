#include <stdio.h>

    int main() {
        int n;
        printf("enter size of arrays :");
        scanf("%d", &n);
        int num1[30];
        printf("enter first array one by one :");
        for(int i=0; i<n; i++){
            scanf("%d",&num1[i]);
        }
        int num2[30];
        printf("enter second array one by one :");
        for(int i=0; i<n; i++){
            scanf("%d",&num2[i]);
        }
        int common[30];

        int k = 0;
        for(int i=0; i<n; i++){

            for(int j=0; j<n; j++){   

                if(num1[i] == num2[j]){

                    int already = 0;

                    for(int x=0; x<k; x++){

                        if(common[x] == num1[i]){

                            already = 1;
                            break;

                        }
                    }

                    if(already == 0){
                        common[k] = num1[i];
                        k++;
                    }
                    break;
            }
        }
    }
        printf("common elements : ");
        for(int i=0; i<k; i++){
            printf("%d ",common[i]);
        }
    }
