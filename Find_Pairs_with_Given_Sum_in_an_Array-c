#include <stdio.h>

int main() {
    int n;
    printf("enter size of array :");
    scanf("%d",&n);

    int num[30];
    printf("enter values one by one :");
    for(int i=0; i<n; i++){
        scanf("%d",&num[i]);
    }

    int target;
    printf("Enter Target Number :");
    scanf("%d", &target);

    int pair[30];

    int x=0;
    for(int i=0; i<n; i++){

        for(int j=i+1; j<n; j++){

            if(num[i] + num[j] == target){
                pair[x] = num[i];
                x++;
                pair[x] = num[j];
                x++;
            }

        }

    }

    if(x==0){
        printf("No Pair Found!");
    } else {
        for(int i=0; i<x; i+=2){
        printf("pair : %d %d\n",pair[i] , pair[i+1]);
        }
    }
    return 0;
}
